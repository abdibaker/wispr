{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "voice-prompt",
  "mainBinaryName": "voice-prompt",
  "version": "0.1.0",
  "identifier": "com.abdibaker.voiceprompt",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "Utility",
    "shortDescription": "Push-to-talk prompt dictation",
    "longDescription": "Hold a shortcut, speak, release: the cleaned-up prompt is typed into the focused app.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libpulse0",
          "libgtk-layer-shell0",
          "gnome-keyring | org.freedesktop.secrets"
        ],
        "files": {
          "/usr/share/icons/hicolor/scalable/apps/voice-prompt.svg": "icons/icon.svg",
          "/usr/lib/udev/rules.d/70-voice-prompt-input.rules": "packaging/70-voice-prompt-input.rules"
        },
        "postInstallScript": "packaging/postinst.sh",
        "postRemoveScript": "packaging/postrm.sh",
        "desktopTemplate": "packaging/voice-prompt.desktop"
      }
    }
  }
}
